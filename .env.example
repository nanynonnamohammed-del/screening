# ── Shopify ──────────────────────────────────────────────────────────────────
# Your store URL  (without https://)
SHOPIFY_STORE=mystore.myshopify.com

# Admin API access token — Shopify Admin > Apps > Develop apps > API credentials
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — shown when you create the webhook in Shopify notifications
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bosta ────────────────────────────────────────────────────────────────────
# Your Bosta business API key
BOSTA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL — change only if Bosta gives you a different one
BOSTA_API_BASE=https://app.bosta.co/api/v0
